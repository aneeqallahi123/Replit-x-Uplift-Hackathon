# Copy this to .env for local development.
# On Railway, set these in the project's Variables tab — never commit real values.

# Required — Uplift AI API key
UPLIFT_API_KEY=your_uplift_api_key_here

# Optional — override the Uplift API region.
# Default: https://api.upliftai.org/v1  (US)
# Lower latency from Pakistan: https://ap-southeast-1.api.upliftai.org/v1
# UPLIFT_BASE=https://ap-southeast-1.api.upliftai.org/v1

# Optional — Railway sets PORT automatically; only needed for local dev.
# PORT=5000
